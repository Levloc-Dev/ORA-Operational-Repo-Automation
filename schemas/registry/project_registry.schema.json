{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ora://schemas/registry/project_registry.schema.json",
  "title": "ORA Project Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id"],
        "properties": {
          "project_id": { "type": "string" }
        }
      }
    }
  }
}
